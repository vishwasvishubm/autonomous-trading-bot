# Copy this file to .env and fill in BOT_ACCESS_TOKEN (Participant Guide -> Step 1).
# Never commit .env.
BOT_ACCESS_TOKEN=
TEAM_USERNAME=mn2602
SERVER_IP=192.168.65.157
GATEWAY_PORT=3002
KAFKA_PORT=9094

# core (default: 99% equal-weight core bought on day 1, 30% concentration cap, tax-loss harvest; no shorts)
# active (previous default: 85% core + tactical signal layer)
# hedged (active + shorts the weakest downtrending stock in sell-offs; margin locked)
# tactical (timing only, ~50% invested, lower drawdown)
STRATEGY_PROFILE=core

# parallel Kafka consumers in group-<username> (1-10)
KAFKA_CONSUMERS=1
# send orders in the development sandbox too (live simulation always trades)
TRADE_IN_SANDBOX=false
# decide and log only, never send orders
DRY_RUN=false

# REST budget (platform limit 120/min)
REQUESTS_PER_MINUTE=100
MAX_ORDERS_PER_DAY=10
RECONCILE_EVERY_DAYS=3
DECISION_DELAY_MS=300
NEWS_QUIET_MS=150
NEWS_MAX_WAIT_MS=600
DECISION_MAX_WAIT_MS=2000
HISTORY_DAYS=400
